#compdef dot

_dot() {
  local -a commands
  commands=(
    'install:Install packages from Brewfile, Caskfile, Masfile, Npmfile, and Pluginfile'
    'update:Update dotfiles, Homebrew packages, Oh My Zsh, VS Code extensions, npm tools, and Claude Code plugins'
    'health:Check symlinks, required tools, Claude Code plugins, and asdf runtimes'
    'clean:Clean up caches (brew, gem)'
    'edit:Open dotfiles in VS Code'
    'help:Show help message'
  )
  _describe 'command' commands
}

_dot "$@"
