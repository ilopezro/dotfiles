# Ghostty configuration
# Docs: `ghostty +show-config --default --docs | less`
# Reload in-app with Cmd+Shift+,

# --- Font ---
font-family = "JetBrains Mono"
font-size = 12
font-thicken = true
window-title-font-family = "JetBrains Mono"

# --- Theme (auto light/dark, follows macOS appearance) ---
theme = dark:Catppuccin Mocha,light:Catppuccin Latte

# --- Window ---
background-opacity = 0.96
background-blur-radius = 20
window-padding-x = 10
window-padding-y = 10
macos-titlebar-style = tabs

# --- Cursor & mouse ---
cursor-style = block
mouse-hide-while-typing = true

# --- Behavior ---
confirm-close-surface = true
quit-after-last-window-closed = true

# --- Keybindings ---
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+enter=toggle_fullscreen
# New tabs ask for a title. A prompted title overrides the one the shell sets
# (Oh My Zsh rewrites it on every prompt); press Escape to keep the default.
keybind = cmd+t=new_tab
keybind = chain=prompt_tab_title
# Rename the current tab at any time; submit an empty title to go back to automatic.
keybind = cmd+shift+r=prompt_tab_title

# --- Updates ---
# Temporary: tip channel for the macOS 27 tabs titlebar fix (ghostty#13069).
# Remove once the fix ships in a stable release.
auto-update-channel = tip
