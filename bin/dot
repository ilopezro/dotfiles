#!/bin/sh

DOTFILES_DIR="$HOME/dotfiles"

sub_help() {
  echo "Usage: dot <command>"
  echo ""
  echo "Commands:"
  echo "  install   Install packages from Brewfile, Caskfile, Masfile, and Npmfile, MCP servers from Mcpfile, and Claude Code plugins from Pluginfile (initial setup)"
  echo "  update    Update dotfiles, Homebrew packages, Oh My Zsh, VS Code extensions, npm tools, and Claude Code plugins"
  echo "  health    Check symlinks, commit signing, required tools, Claude Code plugins, and asdf runtimes"
  echo "  clean     Clean up caches (brew, gem)"
  echo "  edit      Open dotfiles in editor"
  echo "  help      This help message"
}

sub_install() {
  echo "Installing Homebrew packages..."
  brew bundle --file="$DOTFILES_DIR/install/Brewfile"

  echo "Installing cask apps..."
  brew bundle --file="$DOTFILES_DIR/install/Caskfile"

  echo "Installing Mac App Store apps..."
  while IFS='|' read -r name id; do
    [ -z "$name" ] && continue
    echo "  Installing $name..."
    mas install "$id" || true
  done < "$DOTFILES_DIR/install/Masfile"

  echo "Installing global npm tools..."
  cat "$DOTFILES_DIR/install/Npmfile" | while read pkg; do
    [ -z "$pkg" ] && continue
    npm install -g "$pkg"
  done

  echo "Configuring Claude Code MCP servers..."
  while IFS='|' read -r name cmd; do
    [ -z "$name" ] && continue
    if claude mcp get "$name" >/dev/null 2>&1; then
      echo "  MCP server already configured: $name"
    else
      echo "  Adding MCP server: $name"
      claude mcp add --scope user "$name" -- $cmd
    fi
  done < "$DOTFILES_DIR/install/Mcpfile"

  if ! command -v claude >/dev/null 2>&1; then
    echo "Skipping Claude Code plugins: claude not found."
  else
    echo "Installing Claude Code plugins..."
    while IFS='|' read -r plugin source; do
      [ -z "$plugin" ] && continue
      market="${plugin#*@}"
      if claude plugin marketplace list 2>/dev/null | grep -q "❯ $market$"; then
        echo "  Marketplace already added: $market"
      else
        echo "  Adding marketplace: $source"
        if ! claude plugin marketplace add "$source"; then
          echo "  Skipping $plugin: could not reach $source (needs GitHub access)."
          continue
        fi
      fi
      if claude plugin list 2>/dev/null | grep -q "❯ $plugin$"; then
        echo "  Plugin already installed: $plugin"
      else
        echo "  Installing plugin: $plugin"
        claude plugin install --scope user "$plugin" ||
          echo "  Skipping $plugin: install failed."
      fi
    done < "$DOTFILES_DIR/install/Pluginfile"
  fi
}

sub_update() {
  echo "[1/6] Updating dotfiles..."
  if git -C "$DOTFILES_DIR" diff --quiet && git -C "$DOTFILES_DIR" diff --cached --quiet; then
    git -C "$DOTFILES_DIR" pull
  else
    echo "  Skipping: you have local changes in $DOTFILES_DIR"
  fi

  echo "[2/6] Updating Homebrew..."
  brew update && brew upgrade

  echo "[3/6] Updating Oh My Zsh..."
  "$ZSH/tools/upgrade.sh"

  echo "[4/6] Updating VS Code extensions..."
  cat "$DOTFILES_DIR/install/Codefile" | while read ext; do
    code --install-extension "$ext" --force 2>/dev/null || true
  done

  echo "[5/6] Updating global npm tools..."
  cat "$DOTFILES_DIR/install/Npmfile" | while read pkg; do
    [ -z "$pkg" ] && continue
    npm install -g "$pkg"
  done

  echo "[6/6] Updating Claude Code plugins..."
  while IFS='|' read -r plugin source; do
    [ -z "$plugin" ] && continue
    claude plugin update "$plugin" 2>/dev/null || true
  done < "$DOTFILES_DIR/install/Pluginfile"

  echo "Done!"
}

sub_health() {
  local ok=1

  _check() {
    local label="$1" result="$2"
    if [ "$result" = "ok" ]; then
      printf "  ✓ %s\n" "$label"
    else
      printf "  ✗ %s (%s)\n" "$label" "$result"
      ok=0
    fi
  }

  echo "Symlinks"
  [ -L "$HOME/.zshrc" ]                && _check ".zshrc"               ok || _check ".zshrc"               "not linked"
  [ -L "$HOME/.tool-versions" ]        && _check ".tool-versions"        ok || _check ".tool-versions"        "not linked"
  [ -L "$HOME/.asdfrc" ]               && _check ".asdfrc"               ok || _check ".asdfrc"               "not linked"
  while IFS='|' read -r src dest; do
    [ -z "$src" ] && continue
    dest=$(printf '%s' "$dest" | sed "s|^\$HOME|$HOME|")
    if [ ! -L "$dest" ]; then
      _check "$src" "not linked"
    elif [ ! -e "$dest" ]; then
      _check "$src" "dangling link"
    else
      _check "$src" ok
    fi
  done < "$DOTFILES_DIR/install/Linkfile"

  echo ""
  echo "Commit signing"
  key_path="$(git config user.signingkey)"
  key_path="${key_path:-$HOME/.ssh/id_ed25519.pub}"
  case "$key_path" in "~"*) key_path="$HOME${key_path#\~}" ;; esac
  if [ ! -f "$key_path" ]; then
    _check "signing key" "no key at $key_path"
  else
    key=$(awk '{print $1" "$2}' "$key_path")
    grep -qF "$key" "$DOTFILES_DIR/config/git/allowed_signers" 2>/dev/null \
      && _check "key trusted in allowed_signers" ok \
      || _check "key trusted in allowed_signers" "run \`make signers\`"
  fi

  echo ""
  echo "Tools"
  for cmd in brew git stow asdf code mas; do
    command -v "$cmd" >/dev/null 2>&1 && _check "$cmd" ok || _check "$cmd" "not found"
  done

  echo ""
  echo "Global npm tools"
  while IFS= read -r pkg; do
    [ -z "$pkg" ] && continue
    npm list -g --depth=0 "$pkg" >/dev/null 2>&1 && _check "$pkg" ok || _check "$pkg" "not installed"
  done < "$DOTFILES_DIR/install/Npmfile"

  echo ""
  echo "Mac App Store apps"
  while IFS='|' read -r name id; do
    [ -z "$name" ] && continue
    mas list 2>/dev/null | grep -q "^$id " && _check "$name" ok || _check "$name" "not installed"
  done < "$DOTFILES_DIR/install/Masfile"

  echo ""
  echo "Claude Code MCP servers"
  while IFS='|' read -r name cmd; do
    [ -z "$name" ] && continue
    claude mcp get "$name" >/dev/null 2>&1 && _check "$name" ok || _check "$name" "not configured"
  done < "$DOTFILES_DIR/install/Mcpfile"

  echo ""
  echo "Claude Code plugins"
  while IFS='|' read -r plugin source; do
    [ -z "$plugin" ] && continue
    claude plugin list 2>/dev/null | grep -q "❯ $plugin$" && _check "$plugin" ok || _check "$plugin" "not installed"
  done < "$DOTFILES_DIR/install/Pluginfile"

  echo ""
  echo "asdf runtimes"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    name=$(echo "$line" | awk '{print $1}')
    version=$(echo "$line" | awk '{print $2}')
    installed=$(asdf list "$name" 2>/dev/null | grep -F "$version")
    [ -n "$installed" ] && _check "$name $version" ok || _check "$name $version" "not installed"
  done < "$DOTFILES_DIR/runcom/.tool-versions"

  echo ""
  [ "$ok" = "1" ] && echo "All checks passed." || echo "Some checks failed. Run \`dot install\` or \`make link\` to fix."
}

sub_clean() {
  echo "Cleaning Homebrew cache..."
  brew cleanup

  echo "Cleaning gem cache..."
  gem cleanup 2>/dev/null
}

sub_edit() {
  code "$DOTFILES_DIR"
}

case "$1" in
  install) sub_install ;;
  update)  sub_update ;;
  health)  sub_health ;;
  clean)   sub_clean ;;
  edit)    sub_edit ;;
  help)    sub_help ;;
  *)       sub_help ;;
esac
