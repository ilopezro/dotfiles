#!/bin/sh

DOTFILES_DIR="$HOME/dotfiles"
. "$DOTFILES_DIR/lib/colors.sh"

help_cmd() {
  printf '  %s%-9s%s %s\n' "$C_BLUE" "$1" "$C_RESET" "$2"
}

sub_help() {
  printf '%sUsage:%s dot <command>\n' "$C_BOLD" "$C_RESET"
  echo ""
  section "Commands:"
  help_cmd install "Install packages from Brewfile, Caskfile, Masfile, and Npmfile, login items from Loginfile, macOS defaults from Defaultsfile, MCP servers from Mcpfile, and Claude Code plugins from Pluginfile (initial setup)"
  help_cmd update  "Update dotfiles, Homebrew packages, Oh My Zsh, VS Code extensions, npm tools, and Claude Code plugins"
  help_cmd health  "Check symlinks, commit signing, required tools, cask apps (and casks not in Caskfile), macOS defaults, login items, Claude Code plugins, and asdf runtimes"
  help_cmd prune   "Uninstall Homebrew casks that are not in Caskfile, asking about each (--all: one prompt for all)"
  help_cmd clean   "Clean up caches (brew, gem)"
  help_cmd edit    "Open dotfiles in editor"
  help_cmd help    "This help message"
}

sub_install() {
  step "Installing Homebrew packages..."
  brew bundle --file="$DOTFILES_DIR/install/Brewfile"

  step "Installing cask apps..."
  brew bundle --file="$DOTFILES_DIR/install/Caskfile" || true
  "$DOTFILES_DIR/bin/cask-doctor" repair

  step "Installing Mac App Store apps..."
  while IFS='|' read -r name id || [ -n "$name" ]; do
    [ -z "$name" ] && continue
    info "Installing $name..."
    mas install "$id" || true
  done < "$DOTFILES_DIR/install/Masfile"

  step "Installing global npm tools..."
  while read -r pkg || [ -n "$pkg" ]; do
    [ -z "$pkg" ] && continue
    npm install -g "$pkg"
  done < "$DOTFILES_DIR/install/Npmfile"

  step "Configuring Claude Code MCP servers..."
  while IFS='|' read -r name cmd || [ -n "$name" ]; do
    [ -z "$name" ] && continue
    if claude mcp get "$name" >/dev/null 2>&1; then
      note "MCP server already configured: $name"
    else
      info "Adding MCP server: $name"
      claude mcp add --scope user "$name" -- $cmd
    fi
  done < "$DOTFILES_DIR/install/Mcpfile"

  step "Registering login items..."
  make -C "$DOTFILES_DIR" --no-print-directory login-items

  step "Applying macOS defaults..."
  "$DOTFILES_DIR/bin/macos-defaults" apply

  if ! command -v claude >/dev/null 2>&1; then
    warn "Skipping Claude Code plugins: claude not found."
  else
    step "Installing Claude Code plugins..."
    while IFS='|' read -r plugin source || [ -n "$plugin" ]; do
      [ -z "$plugin" ] && continue
      market="${plugin#*@}"
      if claude plugin marketplace list 2>/dev/null | grep -q "❯ $market$"; then
        note "Marketplace already added: $market"
      else
        info "Adding marketplace: $source"
        if ! claude plugin marketplace add "$source"; then
          warn "Skipping $plugin: could not reach $source (needs GitHub access)."
          continue
        fi
      fi
      if claude plugin list 2>/dev/null | grep -q "❯ $plugin$"; then
        note "Plugin already installed: $plugin"
      else
        info "Installing plugin: $plugin"
        claude plugin install --scope user "$plugin" ||
          warn "Skipping $plugin: install failed."
      fi
    done < "$DOTFILES_DIR/install/Pluginfile"
  fi
}

sub_update() {
  step "[1/6] Updating dotfiles..."
  if git -C "$DOTFILES_DIR" diff --quiet && git -C "$DOTFILES_DIR" diff --cached --quiet; then
    git -C "$DOTFILES_DIR" pull
  else
    warn "Skipping: you have local changes in $DOTFILES_DIR"
  fi

  step "[2/6] Updating Homebrew..."
  # Self-updating casks (Slack) leave their app root-owned, so upgrading them needs
  # sudo. Without a cached credential brew's prompt fails mid-upgrade and strands a
  # backup in the Caskroom that breaks every later upgrade of that cask.
  if ! sudo -n true 2>/dev/null && [ -t 0 ]; then
    sudo -v
  fi
  local pid=$$
  (while kill -0 "$pid" 2>/dev/null; do sudo -n true; sleep 60; done) >/dev/null 2>&1 &
  brew update
  # Reclaim root-owned apps and restore missing artifacts first, or the upgrade
  # trips over them.
  "$DOTFILES_DIR/bin/cask-doctor" repair
  brew upgrade

  step "[3/6] Updating Oh My Zsh..."
  "$ZSH/tools/upgrade.sh"

  step "[4/6] Updating VS Code extensions..."
  cat "$DOTFILES_DIR/install/Codefile" | while read ext; do
    code --install-extension "$ext" --force 2>/dev/null || true
  done

  step "[5/6] Updating global npm tools..."
  cat "$DOTFILES_DIR/install/Npmfile" | while read pkg; do
    [ -z "$pkg" ] && continue
    npm install -g "$pkg"
  done

  step "[6/6] Updating Claude Code plugins..."
  while IFS='|' read -r plugin source || [ -n "$plugin" ]; do
    [ -z "$plugin" ] && continue
    claude plugin update "$plugin" 2>/dev/null || true
  done < "$DOTFILES_DIR/install/Pluginfile"

  success "Done!"
}

sub_health() {
  local ok=1

  _check() {
    local label="$1" result="$2"
    if [ "$result" = "ok" ]; then
      pass "$label"
    else
      fail "$label ($result)"
      ok=0
    fi
  }

  section "Symlinks"
  [ -L "$HOME/.zshrc" ]                && _check ".zshrc"               ok || _check ".zshrc"               "not linked"
  [ -L "$HOME/.tool-versions" ]        && _check ".tool-versions"        ok || _check ".tool-versions"        "not linked"
  [ -L "$HOME/.asdfrc" ]               && _check ".asdfrc"               ok || _check ".asdfrc"               "not linked"
  while IFS='|' read -r src dest || [ -n "$src" ]; do
    [ -z "$src" ] && continue
    dest=$(printf '%s' "$dest" | sed "s|^\$HOME|$HOME|")
    if [ ! -L "$dest" ]; then
      _check "$src" "not linked"
    elif [ ! -e "$dest" ]; then
      _check "$src" "dangling link"
    else
      _check "$src" ok
    fi
  done < "$DOTFILES_DIR/install/Linkfile"

  echo ""
  section "Commit signing"
  key_path="$(git config user.signingkey)"
  key_path="${key_path:-$HOME/.ssh/id_ed25519.pub}"
  case "$key_path" in "~"*) key_path="$HOME${key_path#\~}" ;; esac
  if [ ! -f "$key_path" ]; then
    _check "signing key" "no key at $key_path"
  else
    key=$(awk '{print $1" "$2}' "$key_path")
    grep -qF "$key" "$DOTFILES_DIR/config/git/allowed_signers" 2>/dev/null \
      && _check "key trusted in allowed_signers" ok \
      || _check "key trusted in allowed_signers" "run \`make signers\`"
  fi

  echo ""
  section "Tools"
  for cmd in brew git stow asdf code mas; do
    command -v "$cmd" >/dev/null 2>&1 && _check "$cmd" ok || _check "$cmd" "not found"
  done

  echo ""
  section "Cask apps"
  if ! "$DOTFILES_DIR/bin/cask-doctor" check; then
    ok=0
    note "Run \`cask-doctor repair\` to fix them."
  fi
  "$DOTFILES_DIR/bin/cask-doctor" extras

  echo ""
  section "Global npm tools"
  while IFS= read -r pkg || [ -n "$pkg" ]; do
    [ -z "$pkg" ] && continue
    npm list -g --depth=0 "$pkg" >/dev/null 2>&1 && _check "$pkg" ok || _check "$pkg" "not installed"
  done < "$DOTFILES_DIR/install/Npmfile"

  echo ""
  section "Mac App Store apps"
  while IFS='|' read -r name id || [ -n "$name" ]; do
    [ -z "$name" ] && continue
    mas list 2>/dev/null | grep -q "^$id " && _check "$name" ok || _check "$name" "not installed"
  done < "$DOTFILES_DIR/install/Masfile"

  echo ""
  section "macOS defaults"
  "$DOTFILES_DIR/bin/macos-defaults" check || ok=0

  echo ""
  section "Login items"
  login_paths=$(osascript -e 'tell application "System Events" to get the path of every login item' 2>/dev/null)
  while IFS= read -r app || [ -n "$app" ]; do
    [ -z "$app" ] && continue
    label=$(basename "$app" .app)
    if [ ! -d "$app" ]; then
      _check "$label" "app not installed"
    elif printf '%s' "$login_paths" | grep -qF "$app"; then
      _check "$label" ok
    else
      _check "$label" "not a login item — run \`make login-items\`"
    fi
  done < "$DOTFILES_DIR/install/Loginfile"

  echo ""
  section "Claude Code MCP servers"
  while IFS='|' read -r name cmd || [ -n "$name" ]; do
    [ -z "$name" ] && continue
    claude mcp get "$name" >/dev/null 2>&1 && _check "$name" ok || _check "$name" "not configured"
  done < "$DOTFILES_DIR/install/Mcpfile"

  echo ""
  section "Claude Code plugins"
  while IFS='|' read -r plugin source || [ -n "$plugin" ]; do
    [ -z "$plugin" ] && continue
    claude plugin list 2>/dev/null | grep -q "❯ $plugin$" && _check "$plugin" ok || _check "$plugin" "not installed"
  done < "$DOTFILES_DIR/install/Pluginfile"

  echo ""
  section "Claude Code skills"
  while IFS= read -r source || [ -n "$source" ]; do
    [ -z "$source" ] && continue
    npx --yes skills list -g 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | grep -q "Source: $source$" \
      && _check "$source" ok || _check "$source" "not installed"
  done < "$DOTFILES_DIR/install/Skillfile"

  echo ""
  section "asdf runtimes"
  while IFS= read -r line || [ -n "$line" ]; do
    [ -z "$line" ] && continue
    name=$(echo "$line" | awk '{print $1}')
    version=$(echo "$line" | awk '{print $2}')
    installed=$(asdf list "$name" 2>/dev/null | grep -F "$version")
    [ -n "$installed" ] && _check "$name $version" ok || _check "$name $version" "not installed"
  done < "$DOTFILES_DIR/runcom/.tool-versions"

  echo ""
  [ "$ok" = "1" ] && success "All checks passed." || error "Some checks failed. Run \`dot install\`, \`make cask-apps\`, or \`make link\` to fix."
}

sub_prune() {
  "$DOTFILES_DIR/bin/cask-doctor" prune "$@"
}

sub_clean() {
  step "Cleaning Homebrew cache..."
  brew cleanup

  step "Cleaning gem cache..."
  gem cleanup 2>/dev/null
}

sub_edit() {
  code "$DOTFILES_DIR"
}

case "$1" in
  install) sub_install ;;
  update)  sub_update ;;
  health)  sub_health ;;
  prune)   shift; sub_prune "$@" ;;
  clean)   sub_clean ;;
  edit)    sub_edit ;;
  help)    sub_help ;;
  *)       sub_help ;;
esac
