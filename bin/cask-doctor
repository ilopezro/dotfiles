#!/usr/bin/env bash
#
# Verify that every cask in install/Caskfile is not just recorded as installed by
# Homebrew, but that its artifacts actually exist on disk. A failed `brew upgrade`
# can delete /Applications/Foo.app while leaving the Caskroom receipt in place, so
# `brew bundle` reports the cask as up to date forever. This catches that drift.
#
# Usage:
#   cask-doctor check    # report status, exit 1 if anything is missing or broken
#   cask-doctor repair   # reinstall whatever is missing or broken, then re-check
#   cask-doctor extras   # list installed casks that are not in the Caskfile
#   cask-doctor prune    # uninstall those extras, confirming each one
#   cask-doctor prune --all  # uninstall all extras after a single confirmation

set -uo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# shellcheck source=../lib/colors.sh
. "$DOTFILES_DIR/lib/colors.sh"
CASKFILE="$DOTFILES_DIR/install/Caskfile"
BREW_PREFIX="$(brew --prefix)"
ME="$(id -un)"

casks() {
  sed -n 's/^cask "\(.*\)".*/\1/p' "$CASKFILE"
}

# `brew list --cask` prints bare tokens, so strip any tap prefix before comparing.
extras() {
  comm -23 <(brew list --cask -1 2>/dev/null | sort -u) <(casks | sed 's|.*/||' | sort -u)
}

# Emit "cask<TAB>app|bin<TAB>artifact" for every App and Binary artifact.
artifacts() {
  brew info --cask "$@" 2>/dev/null | awk '
    /^==> Artifacts$/            { section = "artifacts"; next }
    /^==> / && NF >= 3 && $3 ~ /^\(/ { cask = $2; section = ""; next }
    /^==> /                      { section = ""; next }
    section != "artifacts"       { next }
    /\(App\)$/                   { sub(/ \(App\)$/, ""); print cask "\tapp\t" $0; next }
    /\(Binary\)$/                { sub(/ \(Binary\)$/, ""); print cask "\tbin\t" $0; next }
  '
}

# An artifact may be written as "source -> target"; the target is what actually lands
# on disk, so that is what we check. Keep it whole rather than reducing it to a
# basename: Binary targets are often absolute paths outside the Homebrew prefix
# (docker-desktop links into /usr/local/bin), and dropping the directory made those
# casks read as broken forever no matter how often they were reinstalled.
installed_target() {
  case "$1" in
    *" -> "*) printf '%s\n' "${1##* -> }" ;;
    *)        printf '%s\n' "$1" ;;
  esac
}

# Homebrew moves App artifacts into place as the invoking user. An app that updates
# itself through a privileged helper (Slack does) can come back owned by root, and
# then `brew upgrade` fails with "Permission denied @ apply2files" and strands a
# backup copy in the Caskroom. The bundle and its Contents are checked rather than
# every file, which would mean walking hundreds of MB per app.
foreign_owner() {
  local path="$1" owner
  for owner in $(stat -f '%Su' "$path" "$path/Contents" 2>/dev/null); do
    [ "$owner" != "$ME" ] && { echo "$owner"; return; }
  done
}

# Prints a status word for one cask:
#   ok | missing | broken: <artifact> | owned by <user>: <app path>
status_of() {
  local cask="$1" artifact_lines="$2" kind value target name path owner

  if ! grep -qx "$cask" <<<"$INSTALLED"; then
    echo "missing"
    return
  fi

  while IFS=$'\t' read -r kind value; do
    [ -z "$kind" ] && continue
    target=$(installed_target "$value")
    name=$(basename "$target")
    case "$kind" in
      app)
        for path in "/Applications/$name" "$HOME/Applications/$name"; do
          [ -e "$path" ] || continue
          owner=$(foreign_owner "$path")
          if [ -n "$owner" ]; then
            echo "owned by $owner: $path"
            return
          fi
          continue 2
        done
        ;;
      bin)
        case "$target" in
          /*) [ -e "$target" ] && continue ;;
          *)  [ -e "$BREW_PREFIX/bin/$name" ] && continue ;;
        esac
        ;;
    esac
    echo "broken: $name"
    return
  done <<<"$artifact_lines"

  echo "ok"
}

collect() {
  local cask_list all_artifacts
  cask_list=$(casks)
  [ -z "$cask_list" ] && return 0

  INSTALLED=$(brew list --cask 2>/dev/null)
  # shellcheck disable=SC2086
  all_artifacts=$(artifacts $cask_list)

  local cask
  while IFS= read -r cask; do
    [ -z "$cask" ] && continue
    printf '%s\t%s\n' "$cask" \
      "$(status_of "$cask" "$(awk -F'\t' -v c="$cask" '$1 == c { print $2 "\t" $3 }' <<<"$all_artifacts")")"
  done <<<"$cask_list"
}

# Repairing a cask can need root: casks like docker-desktop own symlinks in
# /usr/local/bin, outside the Homebrew prefix. Homebrew removes those from a sandbox
# child with no controlling terminal, so its sudo prompt blocks forever with echo
# still on. Prime the credential cache here, on the real terminal, before any brew
# work starts.
ensure_sudo() {
  sudo -n true 2>/dev/null && return 0

  if [ ! -t 0 ]; then
    error "cask-doctor: repair needs sudo, but there is no terminal to prompt on." >&2
    note "Run 'sudo -v' in your shell first, then re-run: cask-doctor repair" >&2
    return 1
  fi

  note "Repair needs sudo to remove symlinks outside the Homebrew prefix or reclaim root-owned apps."
  sudo -v
}

# Drop symlinks in the cask bin directories that point into an /Applications path
# which no longer exists. A half-finished uninstall leaves these behind, and brew
# then needs root to clear them. Only ever removes links that are already broken,
# so running it twice is a no-op.
prune_dangling_links() {
  local dir link
  for dir in /usr/local/bin /usr/local/cli-plugins "$BREW_PREFIX/bin"; do
    [ -d "$dir" ] || continue
    for link in "$dir"/*; do
      [ -L "$link" ] || continue
      [ -e "$link" ] && continue
      case "$(readlink "$link")" in
        */Applications/*) ;;
        *) continue ;;
      esac
      info "removing dangling symlink $link"
      rm -f "$link" 2>/dev/null || sudo rm -f "$link"
    done
  done
}

reinstall() {
  local cask="$1"

  prune_dangling_links
  brew reinstall --cask "$cask" && return 0

  warn "reinstall failed, forcing a clean install of $cask..."
  brew uninstall --cask --force "$cask" || true
  prune_dangling_links
  brew install --cask --force "$cask"
}

sub_check() {
  local failed=0 cask status
  while IFS=$'\t' read -r cask status; do
    [ -z "$cask" ] && continue
    if [ "$status" = "ok" ]; then
      pass "$cask"
    else
      fail "$cask ($status)"
      failed=1
    fi
  done < <(collect)
  return $failed
}

sub_repair() {
  local cask status entry
  local -a pending=()

  # Collect first, so the whole list is known before anything is touched. Deciding
  # mid-loop means an interrupt leaves no record of what was still outstanding.
  while IFS=$'\t' read -r cask status; do
    [ -z "$cask" ] && continue
    [ "$status" = "ok" ] && continue
    pending+=("$cask|$status")
  done < <(collect)

  if [ "${#pending[@]}" -eq 0 ]; then
    success "All casks healthy."
    return 0
  fi

  ensure_sudo || return 1

  # Interrupting a cask uninstall part-way is what creates the receipt-without-app
  # state to begin with, so say plainly how to finish it.
  trap 'echo ""; echo "Interrupted. Re-run \`cask-doctor repair\` to finish."; exit 130' INT TERM

  for entry in "${pending[@]}"; do
    cask="${entry%%|*}"
    status="${entry#*|}"
    step "Repairing $cask ($status)..."
    case "$status" in
      "owned by "*)
        # macOS App Management blocks changes to another app's bundle even for root,
        # so an un-granted terminal gets "Operation not permitted" here.
        sudo chown -R "$ME" "${status#*: }" ||
          warn "chown failed. If it said 'Operation not permitted', allow your terminal under System Settings > Privacy & Security > App Management, restart it, and re-run."
        ;;
      *)            reinstall "$cask" ;;
    esac
  done

  trap - INT TERM

  echo ""
  step "Re-checking..."
  sub_check
}

# Extras are reported, never treated as failures: a one-off install is allowed, it
# just should not go unnoticed.
sub_extras() {
  local list cask
  list=$(extras)
  if [ -z "$list" ]; then
    pass "no casks outside Caskfile"
    return 0
  fi
  while IFS= read -r cask; do
    warn "$cask (not in Caskfile)"
  done <<<"$list"
  note "Add them to install/Caskfile to keep them, or run \`dot prune\` to uninstall them."
}

# Prompts per cask by default, since every yes deletes an app. --all asks once for
# the whole list.
sub_prune() {
  local all=0 list cask answer
  [ "${1:-}" = "--all" ] && all=1

  list=$(extras)
  if [ -z "$list" ]; then
    success "No casks outside Caskfile."
    return 0
  fi

  if [ ! -t 0 ]; then
    error "cask-doctor: prune needs a terminal to confirm; nothing was uninstalled." >&2
    return 1
  fi

  section "These casks are installed but not in install/Caskfile:"
  while IFS= read -r cask; do warn "$cask"; done <<<"$list"
  echo ""

  if [ "$all" = "1" ]; then
    printf "%sUninstall all of them?%s [y/N] " "$C_BOLD" "$C_RESET"
    read -r answer
    case "$answer" in
      y|Y|yes|YES) ;;
      *) note "Nothing uninstalled."; return 0 ;;
    esac
  fi

  while IFS= read -r cask <&3; do
    if [ "$all" = "0" ]; then
      printf "%sUninstall %s?%s [y/N] " "$C_BOLD" "$cask" "$C_RESET"
      read -r answer
      case "$answer" in
        y|Y|yes|YES) ;;
        *) note "keeping $cask"; continue ;;
      esac
    fi
    step "Uninstalling $cask..."
    brew uninstall --cask "$cask" || fail "failed to uninstall $cask"
  done 3<<<"$list"
}

case "${1:-check}" in
  check)  sub_check ;;
  repair) sub_repair ;;
  extras) sub_extras ;;
  prune)  sub_prune "${2:-}" ;;
  *)      error "usage: cask-doctor [check|repair|extras|prune [--all]]" >&2; exit 2 ;;
esac
